<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:module:View/Layout:etc/page_configuration.xsd">
    <update handle="loki_admin_components_grid"/>

    <head>
        <title>Directory Country Format Manager</title>
    </head>

    <body>
        <referenceContainer name="content">
            <block
                name="directory_country_format_manager.grid"
                template="Loki_AdminComponents::grid.phtml">
                <arguments>
                    <argument name="provider" xsi:type="string">Magento\Directory\Model\ResourceModel\Country\Format\Collection</argument>
                    <argument name="resource_model" xsi:type="string">Magento\Directory\Model\ResourceModel\Country\Format</argument>
                    <argument name="index_url" xsi:type="string">directory_country_format_manager/index/grid</argument>
                    <argument name="acl_resource" xsi:type="string">Loki_DirectoryCountryFormatManager::grid</argument>
                    <argument name="save_acl_resource" xsi:type="string">Loki_DirectoryCountryFormatManager::save</argument>
                    <argument name="delete_acl_resource" xsi:type="string">Loki_DirectoryCountryFormatManager::delete</argument>
                    <argument name="searchable_fields" xsi:type="array">
                        <item name="country_id" xsi:type="string">country_id</item>
                        <item name="type" xsi:type="string">type</item>
                        <item name="format" xsi:type="string">format</item>
                    </argument>
                    <argument name="button_actions" xsi:type="array">
                        <item name="new" xsi:type="array">
                            <item name="method" xsi:type="string">newAction</item>
                            <item name="label" xsi:type="string" translate="true">Add New</item>
                            <item name="primary" xsi:type="boolean">true</item>
                        </item>
                    </argument>
                    <argument name="grid_filters" xsi:type="array">
                        <item name="country_id" xsi:type="array">
                            <item name="label" xsi:type="string" translate="true">Country</item>
                            <item name="field_type" xsi:type="string">select</item>
                            <item name="condition_type" xsi:type="string">equals</item>
                            <item name="options" xsi:type="object">Loki\AdminComponents\ViewModel\Options\CountryOptions</item>
                        </item>
                        <item name="type" xsi:type="array">
                            <item name="label" xsi:type="string" translate="true">Type</item>
                            <item name="field_type" xsi:type="string">select</item>
                            <item name="condition_type" xsi:type="string">equals</item>
                            <item name="options" xsi:type="object">Loki\DirectoryCountryFormatManager\ViewModel\Options\AddressTemplateTypeOptions</item>
                        </item>
                    </argument>
                    <argument name="columns" xsi:type="array">
                        <item name="country_format_id" xsi:type="array">
                            <item name="label" xsi:type="string" translate="true">ID</item>
                        </item>
                        <item name="country_id" xsi:type="array">
                            <item name="label" xsi:type="string" translate="true">Country</item>
                            <item name="cell_template" xsi:type="string">Loki_DirectoryCountryFormatManager::grid/cell/country.phtml</item>
                        </item>
                        <item name="type" xsi:type="array">
                            <item name="label" xsi:type="string" translate="true">Type</item>
                            <item name="cell_template" xsi:type="string">Loki_DirectoryCountryFormatManager::grid/cell/type.phtml</item>
                        </item>
                        <item name="format" xsi:type="array">
                            <item name="label" xsi:type="string" translate="true">Format</item>
                            <item name="cell_template" xsi:type="string">Loki_AdminComponents::grid/cell/html.phtml</item>
                        </item>
                    </argument>
                </arguments>
            </block>
        </referenceContainer>
    </body>
</page>
