<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Acl/etc/acl.xsd">
    <acl>
        <resources>
            <resource id="Magento_Backend::admin">
                <resource id="Magento_Backend::stores">
                    <resource id="Magento_Backend::stores_settings">
                        <resource id="Loki_DirectoryCountryFormatManager::country_formats" title="Country Format Manager" translate="title" sortOrder="50">
                            <resource id="Loki_DirectoryCountryFormatManager::grid" title="View Country Formats" translate="title" sortOrder="10"/>
                            <resource id="Loki_DirectoryCountryFormatManager::form" title="Open Country Format Form" translate="title" sortOrder="20"/>
                            <resource id="Loki_DirectoryCountryFormatManager::save" title="Save Country Formats" translate="title" sortOrder="30"/>
                            <resource id="Loki_DirectoryCountryFormatManager::delete" title="Delete Country Formats" translate="title" sortOrder="40"/>
                        </resource>
                    </resource>
                </resource>
            </resource>
        </resources>
    </acl>
</config>
